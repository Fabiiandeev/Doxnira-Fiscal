{
  "name": "@ns-fiscal/api-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check-syntax.js",
    "lint": "node scripts/check-syntax.js",
    "build": "node scripts/check-syntax.js",
    "test": "node --env-file=.env.test --test --test-force-exit test/unit/nfe-entry-rules.unit.test.js test/unit/cte-allocation-rules.unit.test.js test/unit/test-database-safety.unit.test.js test/unit/accountant-permissions.unit.test.js test/unit/accountant-documents-filters.unit.test.js test/unit/accountant-document-target.unit.test.js test/unit/accountant-multidocument-db.unit.test.js test/unit/monthly-tax-closing-rules.unit.test.js test/unit/preflight-checks.unit.test.js test/e2e/fiscal-book-preparation.e2e.test.js test/e2e/fiscal-exports.e2e.test.js test/e2e/fiscal-exports-http.e2e.test.js",
    "test:unit": "node --env-file=.env.test --test --test-force-exit test/unit/security-hardening.unit.test.js test/unit/settings.unit.test.js test/unit/accountant-core.unit.test.js test/unit/operation-automation.unit.test.js test/unit/purchase-sales.unit.test.js test/unit/inventory.unit.test.js test/unit/marketplace-operations.unit.test.js test/unit/commerce.unit.test.js test/unit/financial.unit.test.js test/unit/nfe-entry-rules.unit.test.js test/unit/cte-allocation-rules.unit.test.js test/unit/test-database-safety.unit.test.js test/unit/marketplace.unit.test.js test/unit/intelligence.unit.test.js test/unit/fiscal-ai.unit.test.js test/unit/catalogs.unit.test.js test/unit/fiscal-emission.unit.test.js test/unit/fiscal-ops.unit.test.js test/unit/fiscal-compliance.unit.test.js",
    "test:plans": "node --env-file=.env.test --test test/unit/plans.unit.test.js",
    "test:payments": "node --env-file=.env.test --test test/unit/subscription-payments.unit.test.js",
    "test:integration:payments": "node --env-file=.env.test --test test/integration/subscription-payments.integration.test.js",
    "test:cte-allocation": "node --env-file=.env.test --test test/unit/cte-allocation-rules.unit.test.js test/unit/cte-allocation-service.unit.test.js",
    "test:integration": "node --env-file=.env.test --test test/integration/rate-limit-multiprocess.integration.test.js test/integration/operation-automation.integration.test.js test/integration/purchase-sales.integration.test.js test/integration/inventory.integration.test.js test/integration/incoming-nfe.integration.test.js test/integration/marketplace.integration.test.js",
    "test:incoming-nfe": "node --env-file=.env.test --test test/integration/incoming-nfe.integration.test.js",
    "test:http": "node --env-file=.env.test --test test/e2e/incoming-nfe.e2e.test.js",
    "test:http:marketplace": "node --env-file=.env.test --test --test-force-exit test/e2e/marketplace-http.e2e.test.js",
    "test:http:inventory": "node --env-file=.env.test --test --test-force-exit test/e2e/inventory-http.e2e.test.js",
    "test:http:operation-orders": "node --env-file=.env.test --test --test-force-exit test/e2e/purchase-sales-http.e2e.test.js",
    "test:http:operation-automation": "node --env-file=.env.test --test --test-force-exit test/e2e/operation-automation-http.e2e.test.js",
    "test:http:accountant": "node --env-file=.env.test --test --test-force-exit test/e2e/accountant-http.e2e.test.js",
    "test:http:settings": "node --env-file=.env.test --test --test-force-exit test/e2e/settings-http.e2e.test.js",
    "test:http:cte-entry": "node --env-file=.env.test --test test/e2e/cte-entry-allocation.e2e.test.js",
    "test:e2e": "node scripts/preflight-e2e.cjs && node --env-file=.env.test --test test/e2e/incoming-nfe.e2e.test.js && node --env-file=.env.test --test test/e2e/cte-entry-allocation.e2e.test.js && node --env-file=.env.test --test --test-force-exit test/e2e/accountant-workspace.e2e.test.js",
    "test:e2e:incoming-nfe": "node --env-file=.env.test --test test/e2e/incoming-nfe.e2e.test.js",
    "test:coverage": "node --env-file=.env.test --test --experimental-test-coverage test/unit/nfe-entry-rules.unit.test.js test/unit/test-database-safety.unit.test.js test/integration/incoming-nfe.integration.test.js",
    "test:db:migrate": "node scripts/test-db-migrate.mjs",
    "preflight:node": "node scripts/preflight-node.cjs",
    "preflight:pnpm": "node scripts/preflight-pnpm.cjs",
    "preflight:docker": "node scripts/preflight-docker.cjs",
    "preflight:test-database": "node scripts/preflight-test-database.cjs",
    "preflight:e2e": "node scripts/preflight-e2e.cjs",
    "audit:external-migrations": "node scripts/audit-external-migrations.mjs",
    "env:status": "node scripts/environment-status.mjs",
    "smoke:readonly": "node scripts/smoke-readonly.mjs",
    "prisma:generate": "prisma generate --config prisma.config.js",
    "prisma:validate": "prisma validate --config prisma.config.js",
    "prisma:migrate": "prisma migrate dev --config prisma.config.js",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.js",
    "prisma:seed": "prisma db seed --config prisma.config.js",
    "db:seed": "tsx prisma/seed.ts",
    "worker:sync": "node src/modules/sync/sync.worker.js",
    "db:up": "node scripts/db-up.cjs",
    "db:down": "node scripts/db-down.cjs",
    "db:status": "node scripts/db-status.cjs",
    "db:logs": "node scripts/db-logs.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@xmldom/xmldom": "0.8.11",
    "bcryptjs": "3.0.2",
    "bullmq": "5.65.1",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "fast-xml-parser": "5.2.5",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "node-forge": "1.3.1",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "xml-crypto": "6.1.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "prisma": "7.8.0",
    "tsx": "4.19.4"
  }
}

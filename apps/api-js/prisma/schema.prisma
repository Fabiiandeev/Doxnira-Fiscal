  eventType   String   @map("event_type") @db.VarChar(40)
  fromStatus  String?  @map("from_status") @db.VarChar(20)
  toStatus    String?  @map("to_status") @db.VarChar(20)
  message     String?  @db.Text
  metadata    Json?    @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")

  request AccountantDocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  office AccountantOffice @relation(fields: [officeId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  actor User @relation("RequestEventActor", fields: [actorUserId], references: [id])

  @@index([requestId, createdAt])
  @@index([officeId, companyId, createdAt(sort: Desc)])
  @@map("accountant_document_request_events")
}

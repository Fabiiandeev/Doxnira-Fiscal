model SubscriptionPlan {
  id                  String                 @id @default(uuid()) @db.Uuid
  code                String                 @unique @db.VarChar(60)
  slug                String                 @unique @db.VarChar(100)
  name                String                 @db.VarChar(160)
  title               String?                @db.VarChar(200)
  shortDescription    String?                @map("short_description") @db.VarChar(300)
  description         String?                @db.Text
  status              SubscriptionPlanStatus @default(DRAFT)
  publicVisible       Boolean                @default(false) @map("public_visible")
  availableForSale    Boolean                @default(false) @map("available_for_sale")
  featured            Boolean                @default(false)
  sortOrder           Int                    @default(0) @map("sort_order")
  trialDays           Int                    @default(0) @map("trial_days")
  checkoutDescription String?                @map("checkout_description") @db.VarChar(500)
  buttonLabel         String                 @default("Começar agora") @map("button_label") @db.VarChar(100)
  badgeLabel          String?                @map("badge_label") @db.VarChar(100)
  createdById         String?                @map("created_by_id") @db.Uuid
  updatedById         String?                @map("updated_by_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  archivedAt          DateTime?              @map("archived_at")

  createdBy     User?                     @relation("SubscriptionPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                     @relation("SubscriptionPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  prices        SubscriptionPlanPrice[]
  features      SubscriptionPlanFeature[]
  subscriptions Subscription[]
  invoices      SubscriptionInvoice[]

  @@index([status, publicVisible])
  @@index([status, availableForSale])
  @@index([sortOrder])
  @@map("platform_subscription_plans")
}

model SubscriptionPlanPrice {
  id                String                         @id @default(uuid()) @db.Uuid
  planId            String                         @map("plan_id") @db.Uuid
  interval          SubscriptionBillingInterval
  currency          String                         @default("BRL") @db.Char(3)
  amountCents       Int                            @map("amount_cents")
  active            Boolean                        @default(true)
  validFrom         DateTime                       @map("valid_from")
  validUntil        DateTime?                      @map("valid_until")
  applicationPolicy PlanPriceApplicationPolicy     @default(NEW_CUSTOMERS_ONLY) @map("application_policy")
  createdById       String?                        @map("created_by_id") @db.Uuid
  createdAt         DateTime                       @default(now()) @map("created_at")

  plan          SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy     User?                 @relation("SubscriptionPlanPriceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      SubscriptionInvoice[]

  @@index([planId, interval, active])
  @@index([validFrom, validUntil])
  @@map("platform_subscription_plan_prices")
}

model SubscriptionPlanFeature {
  id          String               @id @default(uuid()) @db.Uuid
  planId      String               @map("plan_id") @db.Uuid
  code        String               @db.VarChar(80)
  label       String               @db.VarChar(180)
  description String?              @db.VarChar(400)
  valueType   PlanFeatureValueType @map("value_type")
  value       String?              @db.VarChar(300)
  visible     Boolean              @default(true)
  sortOrder   Int                  @default(0) @map("sort_order")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, code])
  @@index([planId, visible, sortOrder])
  @@map("platform_subscription_plan_features")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  billingAccountId   String             @unique @map("billing_account_id") @db.VarChar(160)
  companyId          String             @unique @map("company_id") @db.Uuid

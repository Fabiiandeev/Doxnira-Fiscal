generator client {
  provider = "prisma-client-js"
}

model MarketplaceConnection {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  provider          String    @db.VarChar(40)
  name              String    @db.VarChar(120)
  status            String    @default("pending_credentials") @db.VarChar(40)
  externalAccountId String?   @map("external_account_id") @db.VarChar(120)
  accessToken       String?   @map("access_token") @db.Text
  refreshToken      String?   @map("refresh_token") @db.Text
  tokenExpiresAt    DateTime? @map("token_expires_at")
  connectedAt       DateTime? @map("connected_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncJobs MarketplaceSyncJob[]
  events MarketplaceSyncEvent[]
  webhookEvents MarketplaceWebhookEvent[]
  cursors MarketplaceSyncCursor[]
  listingLinks MarketplaceListingLink[]
  orders MarketplaceOrder[]

  @@unique([companyId, provider, externalAccountId])
  @@index([companyId, status])
  @@map("marketplace_connections")
}

model MarketplaceSyncCursor {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  connectionId String    @map("connection_id") @db.Uuid
  resourceType String    @map("resource_type") @db.VarChar(40)
  cursor        String?   @db.Text
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resourceType])
  @@index([companyId, resourceType])
  @@map("marketplace_sync_cursors")
}

model MarketplaceSyncJob {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  type           String    @default("FULL") @db.VarChar(30)
  status         String    @default("queued") @db.VarChar(30)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(160)
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events     MarketplaceSyncEvent[]

  @@index([companyId, status])
  @@index([connectionId, createdAt(sort: Desc)])
  @@map("marketplace_sync_jobs")
}

model MarketplaceSyncEvent {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  syncJobId    String?  @map("sync_job_id") @db.Uuid
  type         String   @db.VarChar(60)
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncJob    MarketplaceSyncJob?   @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([connectionId, createdAt(sort: Desc)])
  @@index([syncJobId])
  @@map("marketplace_sync_events")
}

model MarketplaceWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  connectionId    String    @map("connection_id") @db.Uuid
  providerEventId String    @map("provider_event_id") @db.VarChar(160)
  topic           String?   @db.VarChar(120)
  payload         Json
  status          String    @default("received") @db.VarChar(30)
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerEventId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("marketplace_webhook_events")
}

model MarketplaceListingLink {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  connectionId      String   @map("connection_id") @db.Uuid
  providerListingId String   @map("provider_listing_id") @db.VarChar(160)
  sku               String?  @db.VarChar(120)
  title             String?  @db.VarChar(255)
  status            String   @default("active") @db.VarChar(40)
  price             Decimal? @db.Decimal(15, 2)
  promotionalPrice  Decimal? @map("promotional_price") @db.Decimal(15,2)
  productId         String?   @map("product_id") @db.Uuid
  stock             Int?
  category          String?
  condition         String?
  listingType       String?   @map("listing_type")
  reservedStock     Int       @default(0) @map("reserved_stock")
  lastError         String?   @map("last_error")
  currency          String?  @db.Char(3)
  rawPayload        Json?    @map("raw_payload")
  syncedAt          DateTime @default(now()) @map("synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerListingId])
  @@index([companyId, status])
  @@index([companyId, sku])
  @@map("marketplace_listing_links")
}

model MarketplaceOrder {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  connectionId    String    @map("connection_id") @db.Uuid
  providerOrderId String    @map("provider_order_id") @db.VarChar(160)
  status          String    @db.VarChar(40)
  currency        String    @db.Char(3)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(15, 2)
  freightAmount   Decimal   @default(0) @map("freight_amount") @db.Decimal(15, 2)
  discountAmount  Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  commissionAmount Decimal  @default(0) @map("commission_amount") @db.Decimal(15,2)
  fixedFeeAmount Decimal    @default(0) @map("fixed_fee_amount") @db.Decimal(15,2)
  taxAmount Decimal         @default(0) @map("tax_amount") @db.Decimal(15,2)
  adsAmount Decimal         @default(0) @map("ads_amount") @db.Decimal(15,2)
  productCost Decimal       @default(0) @map("product_cost") @db.Decimal(15,2)
  refundAmount Decimal      @default(0) @map("refund_amount") @db.Decimal(15,2)
  chargebackAmount Decimal  @default(0) @map("chargeback_amount") @db.Decimal(15,2)
  financialReceivableId String? @map("financial_receivable_id") @db.Uuid
  reconciliationId String? @map("reconciliation_id") @db.Uuid
  stockReservedAt DateTime? @map("stock_reserved_at")
  internalCanceledAt DateTime? @map("internal_canceled_at")
  orderedAt       DateTime  @map("ordered_at")
  rawPayload      Json?     @map("raw_payload")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  items      MarketplaceOrderItem[]

  @@unique([connectionId, providerOrderId])
  @@index([companyId, status, orderedAt(sort: Desc)])
  @@index([connectionId, orderedAt(sort: Desc)])
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  providerItemId String   @map("provider_item_id") @db.VarChar(160)
  sku            String?  @db.VarChar(120)
  title          String   @db.VarChar(255)
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(15, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  productId      String?  @map("product_id") @db.Uuid
  unitCost       Decimal  @default(0) @map("unit_cost") @db.Decimal(15,2)
  rawPayload     Json?    @map("raw_payload")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, providerItemId])
  @@index([companyId])
  @@map("marketplace_order_items")
}

model CommercePricingStrategy {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name String
  inputs Json
  result Json
  createdAt DateTime @default(now()) @map("created_at")
  @@index([companyId,createdAt])
  @@map("commerce_pricing_strategies")
}

model CommerceCompetitionRecord {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  listingId String? @map("listing_id") @db.Uuid
  competitor String
  price Decimal @db.Decimal(15,2)
  freight Decimal @default(0) @db.Decimal(15,2)
  reputation String?
  rating Decimal? @db.Decimal(5,2)
  deliveryDays Int? @map("delivery_days")
  position Int?
  sourceUrl String? @map("source_url")
  source String @default("MANUAL")
  collectedAt DateTime @map("collected_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([companyId,productId,collectedAt])
  @@map("commerce_competition_records")
}

model CommerceOpportunity {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  type String @db.VarChar(60)
  title String
  description String
  evidence Json
  impact Decimal @default(0) @db.Decimal(15,2)
  priority String @db.VarChar(20)
  provider String?
  productId String? @map("product_id") @db.Uuid
  listingId String? @map("listing_id") @db.Uuid
  assignee String?
  status String @default("OPEN") @db.VarChar(30)
  justification String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([companyId,status,priority])
  @@map("commerce_opportunities")
}

model CommerceAdMetric {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  connectionId String? @map("connection_id") @db.Uuid
  providerCampaignId String @map("provider_campaign_id")
  campaignName String @map("campaign_name")
  listingId String? @map("listing_id") @db.Uuid
  periodStart DateTime @map("period_start")
  periodEnd DateTime @map("period_end")
  investment Decimal @db.Decimal(15,2)
  attributedRevenue Decimal? @map("attributed_revenue") @db.Decimal(15,2)
  attributedOrders Int? @map("attributed_orders")
  status String @db.VarChar(30)
  promotion Json?
  source String @default("PROVIDER_API")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([companyId,providerCampaignId,periodStart,periodEnd])
  @@index([companyId,periodStart,periodEnd])
  @@map("commerce_ad_metrics")
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  OPERATOR
  VIEWER
  PLATFORM_ADMIN
  PLATFORM_SUPER_ADMIN
}

enum SubscriptionPlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionBillingInterval {
  MONTHLY
  YEARLY
}

enum PlanFeatureValueType {
  BOOLEAN
  INTEGER
  TEXT
  UNLIMITED
}

enum PlanPriceApplicationPolicy {
  NEW_CUSTOMERS_ONLY
  ALL_NEXT_RENEWAL
  SELECTED_CUSTOMERS
  SCHEDULED
}

enum PlatformSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum SubscriptionInvoiceStatus {
  PENDING
  OPEN
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum Environment {
  production
  homologation
}

enum MdfeStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  READY_TO_TRANSMIT
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  CLOSED
}

enum MdfeDocumentType {
  NFE
  CTE
}

model MdfeDraft {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  model           String      @default("58") @db.VarChar(2)
  series          String      @default("1") @db.VarChar(10)
  number          String?     @db.VarChar(30)
  environment     Environment @default(homologation)
  emissionType    String      @default("NORMAL") @map("emission_type") @db.VarChar(30)
  issuerType      String      @map("issuer_type") @db.VarChar(30)
  carrierType     String      @map("carrier_type") @db.VarChar(30)
  emissionDate    DateTime?   @map("emission_date")
  loadingState    String?     @map("loading_state") @db.Char(2)
  unloadingState  String?     @map("unloading_state") @db.Char(2)
  loadingCityCode String?     @map("loading_city_code") @db.VarChar(7)
  status          MdfeStatus  @default(DRAFT)
  currentStep     Int         @default(1) @map("current_step")
  version         Int         @default(1)
  additionalInfo  String?     @map("additional_info") @db.Text
  fiscalInfo      String?     @map("fiscal_info") @db.Text
  createdById     String      @map("created_by_id") @db.Uuid
  updatedById     String?     @map("updated_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("MdfeDraftCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("MdfeDraftUpdatedBy", fields: [updatedById], references: [id])
  routeStates MdfeRouteState[]
  unloadingCities MdfeUnloadingCity[]
  vehicle     MdfeVehicle?
  drivers     MdfeDriver[]
  fiscalDocuments MdfeFiscalDocumentLink[]
  insurance   MdfeInsurance?
  validationRuns MdfeValidationRun[]
  events      MdfeEvent[]
  auditLogs   MdfeAuditLog[]

  @@unique([companyId, series, number])
  @@index([companyId, status])
  @@index([companyId, emissionDate(sort: Desc)])
  @@index([companyId, series, number])
  @@map("mdfe_drafts")
}

model MdfeRouteState {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  mdfeDraftId String    @map("mdfe_draft_id") @db.Uuid
  stateCode   String    @map("state_code") @db.Char(2)
  sequence    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  mdfeDraft MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)

  @@unique([mdfeDraftId, stateCode])
  @@unique([mdfeDraftId, sequence])
  @@index([companyId])
  @@index([mdfeDraftId, sequence])
  @@map("mdfe_route_states")
}

model MdfeUnloadingCity {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  mdfeDraftId String    @map("mdfe_draft_id") @db.Uuid
  cityCode    String    @map("city_code") @db.VarChar(7)
  cityName    String    @map("city_name") @db.VarChar(120)
  stateCode   String    @map("state_code") @db.Char(2)
  sequence    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  mdfeDraft MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)

  @@unique([mdfeDraftId, cityCode])
  @@unique([mdfeDraftId, sequence])
  @@index([companyId])
  @@index([mdfeDraftId, sequence])
  @@map("mdfe_unloading_cities")
}

model MdfeVehicle {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  mdfeDraftId           String    @unique @map("mdfe_draft_id") @db.Uuid
  plate                 String    @db.VarChar(7)
  plateState            String?   @map("plate_state") @db.Char(2)
  renavam               String?   @db.VarChar(20)
  rntrc                 String?   @db.VarChar(20)
  tareWeight            Decimal?  @map("tare_weight") @db.Decimal(15, 3)
  capacityKg            Decimal?  @map("capacity_kg") @db.Decimal(15, 3)
  capacityM3            Decimal?  @map("capacity_m3") @db.Decimal(15, 3)
  wheelType             String?   @map("wheel_type") @db.VarChar(30)
  bodyType              String?   @map("body_type") @db.VarChar(30)
  ownerType             String?   @map("owner_type") @db.VarChar(30)
  ownerName             String?   @map("owner_name") @db.VarChar(255)
  ownerCpfCnpj          String?   @map("owner_cpf_cnpj") @db.VarChar(14)
  ownerStateRegistration String?  @map("owner_state_registration") @db.VarChar(40)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  mdfeDraft MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([plate])
  @@index([rntrc])
  @@index([ownerCpfCnpj])
  @@map("mdfe_vehicles")
}

model MdfeDriver {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  mdfeDraftId String   @map("mdfe_draft_id") @db.Uuid
  cpf         String   @db.VarChar(11)
  name        String   @db.VarChar(160)
  sequence    Int
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  mdfeDraft MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)

  @@unique([mdfeDraftId, cpf])
  @@unique([mdfeDraftId, sequence])
  @@index([companyId])
  @@index([mdfeDraftId, sequence])
  @@index([cpf])
  @@map("mdfe_drivers")
}

model MdfeFiscalDocumentLink {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  mdfeDraftId       String           @map("mdfe_draft_id") @db.Uuid
  documentType      MdfeDocumentType @map("document_type")
  nfeEntryId        String?          @map("nfe_entry_id") @db.Uuid
  cteEntryId        String?          @map("cte_entry_id") @db.Uuid
  accessKey         String           @map("access_key") @db.VarChar(44)
  documentNumber    String?          @map("document_number") @db.VarChar(30)
  series            String?          @db.VarChar(10)
  unloadingCityCode String?          @map("unloading_city_code") @db.VarChar(7)
  grossWeight       Decimal?         @map("gross_weight") @db.Decimal(15, 3)
  documentValue     Decimal?         @map("document_value") @db.Decimal(15, 2)
  sequence          Int
  linkSource        String           @default("MANUAL") @map("link_source") @db.VarChar(30)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  mdfeDraft MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)
  nfeEntry  NfeEntry? @relation(fields: [nfeEntryId], references: [id])
  cteEntry  CteEntry? @relation(fields: [cteEntryId], references: [id])

  @@unique([mdfeDraftId, documentType, accessKey])
  @@unique([mdfeDraftId, sequence])
  @@index([companyId])
  @@index([accessKey])
  @@index([nfeEntryId])
  @@index([cteEntryId])
  @@map("mdfe_fiscal_document_links")
}

model MdfeInsurance {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  mdfeDraftId         String   @unique @map("mdfe_draft_id") @db.Uuid
  responsibleType     String   @map("responsible_type") @db.VarChar(30)
  responsibleCpfCnpj  String?  @map("responsible_cpf_cnpj") @db.VarChar(14)
  insurerName         String   @map("insurer_name") @db.VarChar(255)
  insurerCnpj         String   @map("insurer_cnpj") @db.VarChar(14)
  policyNumber        String   @map("policy_number") @db.VarChar(80)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  mdfeDraft MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)
  endorsements MdfeInsuranceEndorsement[]

  @@index([companyId])
  @@index([insurerCnpj])
  @@index([policyNumber])
  @@map("mdfe_insurances")
}

model MdfeInsuranceEndorsement {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  mdfeInsuranceId String        @map("mdfe_insurance_id") @db.Uuid
  endorsementNumber String      @map("endorsement_number") @db.VarChar(80)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id])
  mdfeInsurance MdfeInsurance @relation(fields: [mdfeInsuranceId], references: [id], onDelete: Cascade)

  @@unique([mdfeInsuranceId, endorsementNumber])
  @@index([companyId])
  @@index([mdfeInsuranceId])
  @@map("mdfe_insurance_endorsements")
}

model MdfeValidationRun {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  mdfeDraftId         String   @map("mdfe_draft_id") @db.Uuid
  version             Int
  status              String   @db.VarChar(30)
  isValid             Boolean  @map("is_valid")
  blockingIssuesCount Int      @default(0) @map("blocking_issues_count")
  warningIssuesCount  Int      @default(0) @map("warning_issues_count")
  calculationHash     String?  @map("calculation_hash") @db.VarChar(64)
  requestedById       String?  @map("requested_by_id") @db.Uuid
  requestId           String?  @map("request_id") @db.VarChar(80)
  startedAt           DateTime @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime @default(now()) @map("created_at")

  company     Company   @relation(fields: [companyId], references: [id])
  mdfeDraft   MdfeDraft @relation(fields: [mdfeDraftId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("MdfeValidationRequestedBy", fields: [requestedById], references: [id])
  issues      MdfeValidationIssue[]

  @@index([companyId])
  @@index([mdfeDraftId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("mdfe_validation_runs")
}

model MdfeValidationIssue {
